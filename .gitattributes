# Shell scripts must use LF endings so they run on Linux regardless of the
# platform they were committed from (this repo is developed on Windows too).
*.sh text eol=lf

# Generated by scripts/generate-rdp-bindings.sh, which always writes LF and
# compares byte for byte in --check mode; keep CRLF checkouts from looking stale.
src/rdp/windows/bindings.rs text eol=lf
