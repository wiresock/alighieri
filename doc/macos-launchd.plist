<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wiresock.alighieri</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/alighieri</string>
		<string>/usr/local/etc/alighieri/alighieri.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/alighieri.out.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/alighieri.err.log</string>
</dict>
</plist>
